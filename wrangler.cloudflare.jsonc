{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "namtong-dfi-restock",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "keep_vars": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "namtong-dfi-restock-db",
      "database_id": "705f262f-c1b1-41d9-9351-7b6281bcf9fa",
      "migrations_dir": "drizzle"
    }
  ]
}
